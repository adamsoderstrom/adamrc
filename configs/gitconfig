[core]
    pager = delta
[pull]
    ff=only
[user]
	name = adamsoderstrom
	email = adamsoderstrom@me.com
[alias]
	adog = log --all --decorate --oneline --graph
[init]
	defaultBranch = main
  pager = delta
[interactive]
    diffFilter = delta
[delta]
    navigate = true    # use n and N to move between diff sections
    paging = always
    syntax-theme = gruvbox-dark
    side-by-side = true
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
[rebase]
    autosquash = true
[rerere]
    enabled = true
[http]
	postBuffer = 157286400
[branch]
    sort = -committerdate
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
